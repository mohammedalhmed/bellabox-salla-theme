  "salla": {
    "name": "BellaBox",
    "description": "ثيم بيلابوكس - تصميم احترافي وراقٍ لمتاجر التجميل والعناية بالبشرة على منصة سلة",
    "version": "2.1.0",
    "preview_url": "https://bellaboxksa.com",
    "support_url": "https://github.com/mohammedalhmed/bellabox-salla-theme",
